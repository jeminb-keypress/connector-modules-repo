<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_shopify_sync_job_action" model="ir.actions.act_window">
        <field name="name">Sync Jobs</field>
        <field name="res_model">kits.connector.sync.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('platform_type', '=', 'shopify')]</field>
        <field name="search_view_id" ref="kits_odoo_base_connector.kits_connector_sync_job_view_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <record id="kits_shopify_log_action" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">kits.connector.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('platform_type', '=', 'shopify')]</field>
        <field name="search_view_id" ref="kits_odoo_base_connector.kits_connector_log_view_search"/>
    </record>

    <record id="kits_shopify_binding_action" model="ir.actions.act_window">
        <field name="name">Bindings</field>
        <field name="res_model">kits.connector.binding</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('platform_type', '=', 'shopify')]</field>
        <field name="search_view_id" ref="kits_odoo_base_connector.kits_connector_binding_view_search"/>
    </record>

    <menuitem id="kits_shopify_menu_root"
              name="Shopify"
              sequence="55"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_shopify_menu_stores"
              name="Stores"
              parent="kits_shopify_menu_root"
              action="kits_shopify_instance_action"
              sequence="10"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_shopify_menu_sync_jobs"
              name="Sync Jobs"
              parent="kits_shopify_menu_root"
              action="kits_shopify_sync_job_action"
              sequence="20"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_shopify_menu_logs"
              name="Logs"
              parent="kits_shopify_menu_root"
              action="kits_shopify_log_action"
              sequence="30"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_shopify_menu_bindings"
              name="Bindings"
              parent="kits_shopify_menu_root"
              action="kits_shopify_binding_action"
              sequence="40"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_shopify_menu_config"
              name="Configuration"
              parent="kits_shopify_menu_root"
              sequence="90"
              groups="kits_odoo_base_connector.group_kits_connector_manager"/>

    <menuitem id="kits_shopify_menu_config_stores"
              name="Shopify Settings"
              parent="kits_shopify_menu_config"
              action="kits_shopify_instance_action"
              sequence="10"
              groups="kits_odoo_base_connector.group_kits_connector_manager"/>
</odoo>
