<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_connector_binding_view_list" model="ir.ui.view">
        <field name="name">kits.connector.binding.list</field>
        <field name="model">kits.connector.binding</field>
        <field name="arch" type="xml">
            <list string="External Bindings">
                <field name="instance_id"/>
                <field name="platform_type" optional="show"/>
                <field name="odoo_model"/>
                <field name="odoo_record_id"/>
                <field name="external_id"/>
                <field name="sync_date"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="kits_connector_binding_view_form" model="ir.ui.view">
        <field name="name">kits.connector.binding.form</field>
        <field name="model">kits.connector.binding</field>
        <field name="arch" type="xml">
            <form string="External Binding">
                <header>
                    <button name="action_open_odoo_record"
                            type="object"
                            string="Open Odoo Record"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="Mapping">
                            <field name="instance_id"/>
                            <field name="platform_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="odoo_model"/>
                            <field name="odoo_record_id"/>
                            <field name="external_id"/>
                            <field name="sync_date"/>
                            <field name="active"/>
                        </group>
                        <group string="External Data">
                            <field name="external_data" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_connector_binding_view_search" model="ir.ui.view">
        <field name="name">kits.connector.binding.search</field>
        <field name="model">kits.connector.binding</field>
        <field name="arch" type="xml">
            <search string="Search Bindings">
                <field name="external_id"/>
                <field name="odoo_model"/>
                <field name="odoo_record_id"/>
                <field name="instance_id"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Instance" name="group_instance" context="{'group_by': 'instance_id'}"/>
                <filter string="Odoo Model" name="group_model" context="{'group_by': 'odoo_model'}"/>
            </search>
        </field>
    </record>

    <record id="kits_connector_binding_action" model="ir.actions.act_window">
        <field name="name">External Bindings</field>
        <field name="res_model">kits.connector.binding</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="kits_connector_binding_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No external bindings yet
            </p>
            <p>
                Bindings map external platform IDs to Odoo records and prevent duplicate syncing.
            </p>
        </field>
    </record>
</odoo>
