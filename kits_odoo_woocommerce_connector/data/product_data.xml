<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Service products used for shipping / discount lines on imported orders -->
    <record id="product_woo_shipping" model="product.product">
        <field name="name">WooCommerce Shipping</field>
        <field name="type">service</field>
        <field name="default_code">WOO_SHIPPING</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>

    <record id="product_woo_discount" model="product.product">
        <field name="name">WooCommerce Discount</field>
        <field name="type">service</field>
        <field name="default_code">WOO_DISCOUNT</field>
        <field name="list_price">0.0</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>
</odoo>
