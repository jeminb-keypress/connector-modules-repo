<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_woo_product_waiting" model="ir.cron">
        <field name="name">WooCommerce: Process Product Waiting List</field>
        <field name="model_id" search="[('model', '=', 'kits.woo.product.waiting')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_product_waiting()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_woo_product_images" model="ir.cron">
        <field name="name">WooCommerce: Process Product Images</field>
        <field name="model_id" search="[('model', '=', 'kits.woo.product.waiting')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_product_images()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">50</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_woo_auto_import_products" model="ir.cron">
        <field name="name">WooCommerce: Automatic Daily Product Import</field>
        <field name="model_id" search="[('model', '=', 'kits.woo.instance')]"/>
        <field name="state">code</field>
        <field name="code">model._cron_woo_auto_import_products()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
