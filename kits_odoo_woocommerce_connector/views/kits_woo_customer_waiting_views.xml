<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_woo_customer_waiting_view_list" model="ir.ui.view">
        <field name="name">kits.woo.customer.waiting.list</field>
        <field name="model">kits.woo.customer.waiting</field>
        <field name="arch" type="xml">
            <list>
                <field name="instance_id"/>
                <field name="external_id"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="source"/>
                <field name="event_type"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="create_date"/>
                <field name="processed_at"/>
                <field name="partner_id" optional="hide"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_customer_waiting_view_form" model="ir.ui.view">
        <field name="name">kits.woo.customer.waiting.form</field>
        <field name="model">kits.woo.customer.waiting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process_selected" type="object" string="Process"
                            class="btn-primary"
                            invisible="state not in ('pending', 'failed', 'manual')"/>
                    <button name="action_retry_failed" type="object" string="Retry"
                            invisible="state not in ('failed', 'manual')"/>
                    <button name="action_open_partner" type="object" string="View Contact"
                            invisible="not partner_id"/>
                    <button name="action_open_store" type="object" string="View Store"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,done,failed,manual,skipped"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="external_id"/>
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="event_type"/>
                            <field name="attempt_count"/>
                            <field name="max_attempts"/>
                            <field name="event_timestamp"/>
                            <field name="processed_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Error Details" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Payload" groups="kits_odoo_base_connector.group_kits_connector_manager">
                        <field name="payload" nolabel="1" colspan="2" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_customer_waiting_view_search" model="ir.ui.view">
        <field name="name">kits.woo.customer.waiting.search</field>
        <field name="model">kits.woo.customer.waiting</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_id"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="instance_id"/>
                <field name="partner_id"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_processing" string="Processing" domain="[('state', '=', 'processing')]"/>
                <filter name="filter_done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="filter_manual" string="Manual Action Required" domain="[('state', '=', 'manual')]"/>
                <filter name="filter_skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <separator/>
                <filter name="filter_bulk" string="Bulk Import" domain="[('source', '=', 'bulk_import')]"/>
                <filter name="filter_webhook" string="Webhook" domain="[('source', '=', 'webhook')]"/>
                <filter name="filter_order" string="Order" domain="[('source', '=', 'order')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kits_woo_customer_waiting_action" model="ir.actions.act_window">
        <field name="name">Customer Waiting List</field>
        <field name="res_model">kits.woo.customer.waiting</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

</odoo>
