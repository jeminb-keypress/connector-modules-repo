<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_woo_connector" model="ir.ui.view">
        <field name="name">res.partner.form.woocommerce</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="visibility">public</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_kits_open_bindings"
                        type="object"
                        class="oe_stat_button"
                        icon="link"
                        invisible="kits_binding_count == 0"
                        groups="kits_odoo_base_connector.group_kits_connector_user">
                    <field name="kits_binding_count" widget="statinfo" string="Bindings"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='website']" position="before">
                <field name="woo_company_name" invisible="not woo_company_name"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Connectors"
                      name="kits_connectors"
                      groups="kits_odoo_base_connector.group_kits_connector_user"
                      invisible="parent_id">
                    <group>
                        <field name="woo_instance_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_open': True}"
                                readonly="1"/>
                    </group>
                    <group string="WooCommerce" name="woo_customer_sync">
                        <field name="woo_is_store_customer"/>
                        <field name="woo_sync_state"/>
                        <field name="woo_binding_count"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_woo_connector" model="ir.ui.view">
        <field name="name">res.partner.list.woocommerce</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="visibility">public</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="woo_sync_state" optional="hide"/>
                <field name="woo_instance_ids" widget="many2many_tags" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="kits_woo_customer_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.woocommerce.customers</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="WooCommerce Customers">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="woo_instance_ids"/>
                <separator/>
                <filter name="filter_has_woo_store"
                        string="Has WooCommerce Store"
                        domain="[('woo_instance_ids', '!=', False)]"/>
                <filter name="filter_no_woo_store"
                        string="No WooCommerce Store"
                        domain="[('woo_instance_ids', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="group_woo_connected_store"
                            string="Connected Store"
                            context="{'group_by': 'woo_instance_ids'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
