<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_woo_customer_binding_view_list" model="ir.ui.view">
        <field name="name">kits.woo.customer.binding.list</field>
        <field name="model">kits.woo.customer.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_customer_binding_view_form" model="ir.ui.view">
        <field name="name">kits.woo.customer.binding.form</field>
        <field name="model">kits.woo.customer.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="external_id"/>
                        </group>
                        <group>
                            <field name="instance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_customer_binding_view_search" model="ir.ui.view">
        <field name="name">kits.woo.customer.binding.search</field>
        <field name="model">kits.woo.customer.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_store" string="Store" context="{'group_by': 'instance_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kits_woo_customer_binding_action" model="ir.actions.act_window">
        <field name="name">Customer Bindings</field>
        <field name="res_model">kits.woo.customer.binding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="kits_woo_product_binding_view_list" model="ir.ui.view">
        <field name="name">kits.woo.product.binding.list</field>
        <field name="model">kits.woo.product.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_tmpl_id"/>
                <field name="title"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <field name="product_type"/>
                <field name="published"/>
                <field name="exists_in_store"/>
                <field name="variant_count"/>
                <field name="linked_variant_count"/>
                <field name="sync_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_product_binding_view_form" model="ir.ui.view">
        <field name="name">kits.woo.product.binding.form</field>
        <field name="model">kits.woo.product.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_variants" type="object" class="oe_stat_button" icon="link">
                            <field name="linked_variant_count" widget="statinfo" string="Variants"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="product_tmpl_id"/>
                            <field name="external_id"/>
                            <field name="instance_id"/>
                            <field name="product_type"/>
                            <field name="published"/>
                            <field name="exists_in_store"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="title"/>
                            <field name="taxable"/>
                            <field name="virtual"/>
                            <field name="variant_count"/>
                            <field name="store_create_date"/>
                            <field name="store_write_date"/>
                            <field name="sync_state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="category_ids" widget="many2many_tags"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="description_short"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Variant Bindings" name="variants">
                            <field name="variant_binding_ids">
                                <list>
                                    <field name="product_id"/>
                                    <field name="external_id"/>
                                    <field name="sku"/>
                                    <field name="title"/>
                                    <field name="exists_in_store"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_product_binding_view_search" model="ir.ui.view">
        <field name="name">kits.woo.product.binding.search</field>
        <field name="model">kits.woo.product.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="external_id"/>
                <field name="product_tmpl_id"/>
                <field name="instance_id"/>
                <filter name="filter_published" string="Published" domain="[('published', '=', True)]"/>
                <filter name="filter_in_store" string="Exists in Store" domain="[('exists_in_store', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_store" string="Store" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_type" string="Product Type" context="{'group_by': 'product_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kits_woo_product_binding_action" model="ir.actions.act_window">
        <field name="name">Product Bindings</field>
        <field name="res_model">kits.woo.product.binding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="kits_woo_variant_binding_view_list" model="ir.ui.view">
        <field name="name">kits.woo.variant.binding.list</field>
        <field name="model">kits.woo.variant.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="product_binding_id"/>
                <field name="external_id"/>
                <field name="sku"/>
                <field name="instance_id"/>
                <field name="exists_in_store"/>
                <field name="manage_stock"/>
                <field name="qty_sync_rule"/>
                <field name="sync_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_variant_binding_view_form" model="ir.ui.view">
        <field name="name">kits.woo.variant.binding.form</field>
        <field name="model">kits.woo.variant.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_binding_id"/>
                            <field name="external_id"/>
                            <field name="sku"/>
                            <field name="title"/>
                            <field name="product_url"/>
                        </group>
                        <group>
                            <field name="instance_id"/>
                            <field name="exists_in_store"/>
                            <field name="manage_stock"/>
                            <field name="qty_sync_rule"/>
                            <field name="qty_sync_value" invisible="qty_sync_rule == 'odoo'"/>
                            <field name="store_create_date"/>
                            <field name="store_write_date"/>
                            <field name="active"/>
                            <field name="sync_state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_variant_binding_view_search" model="ir.ui.view">
        <field name="name">kits.woo.variant.binding.search</field>
        <field name="model">kits.woo.variant.binding</field>
        <field name="arch" type="xml">
            <search>
                <field name="sku"/>
                <field name="external_id"/>
                <field name="product_id"/>
                <field name="product_binding_id"/>
                <field name="instance_id"/>
                <filter name="filter_in_store" string="Exists in Store" domain="[('exists_in_store', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_store" string="Store" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_product" string="Product Binding" context="{'group_by': 'product_binding_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kits_woo_variant_binding_action" model="ir.actions.act_window">
        <field name="name">Variant Bindings</field>
        <field name="res_model">kits.woo.variant.binding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
