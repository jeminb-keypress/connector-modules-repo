<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_woo" model="ir.ui.view">
        <field name="name">sale.order.form.woocommerce</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']" position="after">
                <group string="WooCommerce" name="woo_info" invisible="not woo_order_id">
                    <field name="woo_instance_id" readonly="1"/>
                    <field name="woo_order_id" readonly="1"/>
                    <field name="woo_order_status" readonly="1"/>
                    <field name="woo_sync_conflict" readonly="1"
                              invisible="not woo_sync_conflict"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_woo" model="ir.ui.view">
        <field name="name">sale.order.search.woocommerce</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter string="WooCommerce Orders"
                        name="filter_woo_orders"
                        domain="[('woo_order_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
