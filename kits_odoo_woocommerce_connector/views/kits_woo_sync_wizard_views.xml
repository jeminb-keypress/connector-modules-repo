<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_woo_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">kits.woo.sync.wizard.form</field>
        <field name="model">kits.woo.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="WooCommerce Sync Operation">
                <group>
                    <field name="instance_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="operation"/>
                    <field name="product_import_mode" invisible="operation != 'import_products'"/>
                    <field name="skip_existing" invisible="operation != 'import_products'"/>
                    <field name="product_ids_text"
                            invisible="operation != 'import_specific_products'"
                            required="operation == 'import_specific_products'"
                            placeholder="111,222,333"/>
                    <field name="date_from"
                            invisible="operation not in ('import_unshipped_orders', 'import_shipped_orders')"/>
                    <field name="date_to"
                            invisible="operation not in ('import_unshipped_orders', 'import_shipped_orders')"/>
                    <field name="order_ids_text"
                            invisible="operation != 'import_specific_orders'"
                            required="operation == 'import_specific_orders'"
                            placeholder="9001,9002"/>
                    <field name="stock_from" invisible="operation != 'export_stock'"/>
                    <field name="mapping_file" filename="mapping_filename"
                            invisible="operation != 'map_products'"
                            required="operation == 'map_products'"/>
                    <field name="mapping_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_execute"
                            type="object"
                            string="Run"
                            class="btn-primary"
                            groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="kits_woo_instance_picker_view_form" model="ir.ui.view">
        <field name="name">kits.woo.instance.picker.form</field>
        <field name="model">kits.woo.instance.picker</field>
        <field name="arch" type="xml">
            <form string="Choose WooCommerce Store">
                <group>
                    <field name="operation"/>
                    <field name="instance_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="template_ids" widget="many2many_tags" readonly="1"
                             invisible="not template_ids"/>
                    <field name="partner_ids" widget="many2many_tags" readonly="1"
                             invisible="not partner_ids"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Continue"
                            class="btn-primary"
                            groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="kits_woo_customer_fetch_view_form" model="ir.ui.view">
        <field name="name">kits.woo.customer.fetch.form</field>
        <field name="model">kits.woo.customer.fetch</field>
        <field name="arch" type="xml">
            <form string="Fetch Customer from WooCommerce">
                <group>
                    <field name="instance_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="woo_customer_id" placeholder="e.g. 42"/>
                    <field name="source_partner_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_fetch"
                            type="object"
                            string="Fetch"
                            class="btn-primary"
                            groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="kits_woo_sync_wizard_action" model="ir.actions.act_window">
        <field name="name">Sync Operation</field>
        <field name="res_model">kits.woo.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
