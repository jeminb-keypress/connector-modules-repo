<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_woo_sync_job_action" model="ir.actions.act_window">
        <field name="name">Sync Jobs</field>
        <field name="res_model">kits.connector.sync.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('platform_type', '=', 'woocommerce')]</field>
        <field name="search_view_id" ref="kits_odoo_base_connector.kits_connector_sync_job_view_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <record id="kits_woo_log_action" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">kits.connector.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('platform_type', '=', 'woocommerce')]</field>
        <field name="search_view_id" ref="kits_odoo_base_connector.kits_connector_log_view_search"/>
    </record>

    <menuitem id="kits_woo_menu_root"
              name="WooCommerce"
              sequence="50"
              web_icon="kits_odoo_woocommerce_connector,static/description/icon.png"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <record id="kits_woo_sale_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('woo_order_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_woo_orders': 1}</field>
    </record>

    <record id="kits_woo_customer_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('woo_is_store_customer', '=', True), ('parent_id', '=', False)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
    </record>

    <record id="kits_woo_product_template_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('woo_instance_ids', '!=', False)]</field>
    </record>

    <menuitem id="kits_woo_menu_stores"
              name="Stores"
              parent="kits_woo_menu_root"
              action="kits_woo_instance_action"
              sequence="10"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_sale"
              name="Sale"
              parent="kits_woo_menu_root"
              sequence="20"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_orders"
              name="Orders"
              parent="kits_woo_menu_sale"
              action="kits_woo_sale_order_action"
              sequence="10"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_customers"
              name="Customers"
              parent="kits_woo_menu_sale"
              action="kits_woo_customer_action"
              sequence="20"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_customer_bindings"
              name="Customer Bindings"
              parent="kits_woo_menu_sale"
              action="kits_woo_customer_binding_action"
              sequence="30"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_refunds"
              name="Refunds"
              parent="kits_woo_menu_sale"
              action="kits_woo_refund_action"
              sequence="40"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_product"
              name="Product"
              parent="kits_woo_menu_root"
              sequence="30"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_products"
              name="Products"
              parent="kits_woo_menu_product"
              action="kits_woo_product_template_action"
              sequence="10"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_product_bindings"
              name="Product Bindings"
              parent="kits_woo_menu_product"
              action="kits_woo_product_binding_action"
              sequence="20"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_variant_bindings"
              name="Variant Bindings"
              parent="kits_woo_menu_product"
              action="kits_woo_variant_binding_action"
              sequence="30"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_sync_operation"
              name="Sync Operations"
              parent="kits_woo_menu_root"
              action="kits_woo_sync_wizard_action"
              sequence="40"
              groups="kits_odoo_base_connector.group_kits_connector_manager"/>

    <menuitem id="kits_woo_menu_sync_jobs"
              name="Sync Jobs"
              parent="kits_woo_menu_root"
              action="kits_woo_sync_job_action"
              sequence="50"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_logs"
              name="Logs"
              parent="kits_woo_menu_root"
              action="kits_woo_log_action"
              sequence="60"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_coupons"
              name="Coupons"
              parent="kits_woo_menu_root"
              action="kits_woo_coupon_action"
              sequence="70"
              groups="kits_odoo_base_connector.group_kits_connector_user"/>

    <menuitem id="kits_woo_menu_config"
              name="Configuration"
              parent="kits_woo_menu_root"
              sequence="90"
              groups="kits_odoo_base_connector.group_kits_connector_manager"/>

    <menuitem id="kits_woo_menu_config_stores"
              name="WooCommerce Settings"
              parent="kits_woo_menu_config"
              action="kits_woo_instance_action"
              sequence="10"
              groups="kits_odoo_base_connector.group_kits_connector_manager"/>
</odoo>
