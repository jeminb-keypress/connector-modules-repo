<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_woo_refund" model="ir.ui.view">
        <field name="name">account.move.form.woocommerce.refund</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_woo_export_refund"
                        type="object"
                        string="Refund in WooCommerce"
                        invisible="move_type != 'out_refund' or state == 'cancel'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
