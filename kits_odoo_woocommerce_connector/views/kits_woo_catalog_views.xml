<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Products = store-specific product bindings -->
    <record id="kits_woo_product_catalog_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">kits.woo.product.binding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No WooCommerce products linked yet</p>
            <p>Import products from Sync Operations or enable product webhooks.</p>
        </field>
    </record>

    <record id="kits_woo_variant_catalog_action" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">kits.woo.variant.binding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- Categories -->
    <record id="kits_woo_category_view_list" model="ir.ui.view">
        <field name="name">kits.woo.category.list</field>
        <field name="model">kits.woo.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <field name="slug" optional="hide"/>
                <field name="display_type" optional="hide"/>
                <field name="export_status" widget="badge"/>
                <field name="sync_state" optional="hide" widget="badge"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_category_view_form" model="ir.ui.view">
        <field name="name">kits.woo.category.form</field>
        <field name="model">kits.woo.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id" readonly="1"/>
                            <field name="parent_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="slug"/>
                            <field name="display_type"/>
                        </group>
                        <group>
                            <field name="instance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="image_url"/>
                            <field name="export_status"/>
                            <field name="sync_state"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Sync Error" invisible="not sync_error">
                        <field name="sync_error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_category_view_search" model="ir.ui.view">
        <field name="name">kits.woo.category.search</field>
        <field name="model">kits.woo.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <filter name="filter_pending" string="Not yet exported" domain="[('export_status', '=', 'pending')]"/>
                <filter name="filter_exported" string="Exported" domain="[('export_status', '=', 'exported')]"/>
                <filter name="filter_to_update" string="Update Required" domain="[('export_status', '=', 'to_update')]"/>
                <filter name="filter_error" string="Error" domain="[('export_status', '=', 'error')]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_store" string="Store" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_export" string="Export Status" context="{'group_by': 'export_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kits_woo_category_action" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">kits.woo.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="kits_woo_category_export_selected_action" model="ir.actions.server">
        <field name="name">Export Selected</field>
        <field name="model_id" ref="model_kits_woo_category"/>
        <field name="binding_model_id" ref="model_kits_woo_category"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_selected()</field>
    </record>

    <!-- Tags -->
    <record id="kits_woo_tag_view_list" model="ir.ui.view">
        <field name="name">kits.woo.tag.list</field>
        <field name="model">kits.woo.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <field name="slug" optional="hide"/>
                <field name="export_status" widget="badge"/>
                <field name="sync_state" optional="hide" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_tag_view_form" model="ir.ui.view">
        <field name="name">kits.woo.tag.form</field>
        <field name="model">kits.woo.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id" readonly="1"/>
                            <field name="slug"/>
                        </group>
                        <group>
                            <field name="instance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="export_status"/>
                            <field name="sync_state"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Sync Error" invisible="not sync_error">
                        <field name="sync_error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_tag_view_search" model="ir.ui.view">
        <field name="name">kits.woo.tag.search</field>
        <field name="model">kits.woo.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <filter name="filter_pending" string="Not yet exported" domain="[('export_status', '=', 'pending')]"/>
                <filter name="filter_exported" string="Exported" domain="[('export_status', '=', 'exported')]"/>
                <filter name="filter_to_update" string="Update Required" domain="[('export_status', '=', 'to_update')]"/>
                <filter name="filter_error" string="Error" domain="[('export_status', '=', 'error')]"/>
                <group>
                    <filter name="group_store" string="Store" context="{'group_by': 'instance_id'}"/>
                    <filter name="group_export" string="Export Status" context="{'group_by': 'export_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kits_woo_tag_action" model="ir.actions.act_window">
        <field name="name">Product Tags</field>
        <field name="res_model">kits.woo.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="kits_woo_tag_export_selected_action" model="ir.actions.server">
        <field name="name">Export Selected</field>
        <field name="model_id" ref="model_kits_woo_tag"/>
        <field name="binding_model_id" ref="model_kits_woo_tag"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_selected()</field>
    </record>

    <!-- Attributes -->
    <record id="kits_woo_attribute_view_list" model="ir.ui.view">
        <field name="name">kits.woo.attribute.list</field>
        <field name="model">kits.woo.attribute</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="external_id"/>
                <field name="instance_id"/>
                <field name="display_type"/>
                <field name="order_by" optional="hide"/>
                <field name="odoo_attribute_id"/>
                <field name="sync_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_attribute_view_form" model="ir.ui.view">
        <field name="name">kits.woo.attribute.form</field>
        <field name="model">kits.woo.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id"/>
                            <field name="slug"/>
                            <field name="display_type"/>
                            <field name="order_by"/>
                            <field name="has_archives"/>
                        </group>
                        <group>
                            <field name="instance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="odoo_attribute_id"/>
                            <field name="sync_state"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms" name="terms">
                            <field name="term_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="external_id"/>
                                    <field name="slug"/>
                                    <field name="odoo_attribute_value_id"/>
                                    <field name="sync_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_attribute_action" model="ir.actions.act_window">
        <field name="name">Product Attributes</field>
        <field name="res_model">kits.woo.attribute</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- Attribute Terms -->
    <record id="kits_woo_attribute_term_view_list" model="ir.ui.view">
        <field name="name">kits.woo.attribute.term.list</field>
        <field name="model">kits.woo.attribute.term</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="external_id"/>
                <field name="attribute_id"/>
                <field name="instance_id"/>
                <field name="slug" optional="hide"/>
                <field name="odoo_attribute_value_id"/>
                <field name="sync_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_attribute_term_view_form" model="ir.ui.view">
        <field name="name">kits.woo.attribute.term.form</field>
        <field name="model">kits.woo.attribute.term</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="external_id"/>
                            <field name="attribute_id"/>
                            <field name="slug"/>
                            <field name="odoo_attribute_value_id"/>
                        </group>
                        <group>
                            <field name="instance_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sync_state"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_attribute_term_action" model="ir.actions.act_window">
        <field name="name">Product Attribute Terms</field>
        <field name="res_model">kits.woo.attribute.term</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- Coupon waiting -->
    <record id="kits_woo_coupon_waiting_view_list" model="ir.ui.view">
        <field name="name">kits.woo.coupon.waiting.list</field>
        <field name="model">kits.woo.coupon.waiting</field>
        <field name="arch" type="xml">
            <list>
                <field name="external_id"/>
                <field name="code"/>
                <field name="instance_id"/>
                <field name="source"/>
                <field name="event_type"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="last_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_coupon_waiting_view_form" model="ir.ui.view">
        <field name="name">kits.woo.coupon.waiting.form</field>
        <field name="model">kits.woo.coupon.waiting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            invisible="state not in ('failed', 'manual')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="external_id"/>
                            <field name="code"/>
                            <field name="instance_id"/>
                            <field name="coupon_id"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="event_type"/>
                            <field name="attempt_count"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kits_woo_coupon_waiting_action" model="ir.actions.act_window">
        <field name="name">Coupon Waiting List</field>
        <field name="res_model">kits.woo.coupon.waiting</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>
</odoo>
