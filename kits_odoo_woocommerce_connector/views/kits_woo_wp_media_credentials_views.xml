<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_woo_wp_media_credentials_view_form" model="ir.ui.view">
        <field name="name">kits.woo.wp.media.credentials.form</field>
        <field name="model">kits.woo.wp.media.credentials</field>
        <field name="arch" type="xml">
            <form string="Set WordPress Media Credentials">
                <group>
                    <field name="instance_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="username" placeholder="wp-username"/>
                    <field name="password" widget="password"
                             placeholder="Application password"/>
                </group>
                <div class="alert alert-info" role="status">
                    Used only for product image export via WordPress XML-RPC
                    (<code>metaWeblog.newMediaObject</code>). Stored in the store's
                    internal configuration; never logged.
                </div>
                <footer>
                    <button name="action_save"
                            type="object"
                            string="Save"
                            class="btn-primary"
                            groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_woo_wp_media_credentials" model="ir.actions.act_window">
        <field name="name">Set WordPress Media Credentials</field>
        <field name="res_model">kits.woo.wp.media.credentials</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
