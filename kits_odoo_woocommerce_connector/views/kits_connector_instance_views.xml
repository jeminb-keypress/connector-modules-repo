<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_woo_instance_view_list" model="ir.ui.view">
        <field name="name">kits.woo.instance.list</field>
        <field name="model">kits.woo.instance</field>
        <field name="arch" type="xml">
            <list string="WooCommerce Stores">
                <field name="name"/>
                <field name="platform_type" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                         decoration-success="state == 'connected'"
                         decoration-danger="state == 'error'"
                         decoration-muted="state in ('draft', 'disconnected')"/>
                <field name="base_url" optional="show"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="woo_last_order_sync" optional="hide"/>
                <field name="last_connection_test" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="kits_woo_instance_view_form" model="ir.ui.view">
        <field name="name">kits.woo.instance.form</field>
        <field name="model">kits.woo.instance</field>
        <field name="arch" type="xml">
            <form string="WooCommerce Store">
                <header>
                    <button name="action_test_connection"
                            type="object"
                            string="Test Connection"
                            class="btn-primary"
                            groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                    <button name="action_set_disconnected"
                            type="object"
                            string="Mark Disconnected"
                            invisible="state == 'disconnected'"
                            groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                    <field name="state" widget="statusbar"
                             statusbar_visible="draft,connected,error,disconnected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sync_jobs" type="object" class="oe_stat_button" icon="checklist">
                            <field name="sync_job_count" widget="statinfo" string="Sync Jobs"/>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="article">
                            <field name="log_count" widget="statinfo" string="Logs"/>
                        </button>
                        <button name="action_view_bindings" type="object" class="oe_stat_button" icon="link">
                            <field name="binding_count" widget="statinfo" string="Bindings"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Main Store"/>
                        </h1>
                    </div>
                    <group>
                        <group name="group_connection" string="Connection">
                            <field name="platform_type" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="base_url" placeholder="https://example.com"/>
                            <field name="timeout"/>
                            <field name="active"/>
                        </group>
                        <group name="group_credentials"
                               string="Credentials"
                               groups="kits_odoo_base_connector.group_kits_connector_manager">
                            <field name="api_key" widget="password" invisible="1"/>
                            <field name="api_secret" widget="password" invisible="1"/>
                            <field name="last_connection_test"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extra Configuration" name="config">
                            <field name="config_json"/>
                            <field name="notes" placeholder="Internal notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="kits_woo_instance_view_search" model="ir.ui.view">
        <field name="name">kits.woo.instance.search</field>
        <field name="model">kits.woo.instance</field>
        <field name="arch" type="xml">
            <search string="Search WooCommerce Stores">
                <field name="name"/>
                <field name="base_url"/>
                <field name="company_id"/>
                <filter string="WooCommerce"
                        name="filter_woocommerce"
                        domain="[('platform_type', '=', 'woocommerce')]"/>
                <separator/>
                <filter string="Connected" name="filter_connected" domain="[('state', '=', 'connected')]"/>
                <filter string="Error" name="filter_error" domain="[('state', '=', 'error')]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>


    <record id="kits_connector_instance_view_form_woo" model="ir.ui.view">
        <field name="name">kits.woo.instance.form.woocommerce</field>
        <field name="model">kits.woo.instance</field>
        <field name="inherit_id" ref="kits_woo_instance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_woo_open_sync_wizard"
                        type="object"
                        string="Sync Operation"
                        class="btn-primary"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_export_products"
                        type="object"
                        string="Export Products"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
            </xpath>

            <!-- Hide base Connection/Credentials block for Woo; Store overview sits as a
                 sheet-level group (not nested) so field inputs use full width. -->
            <xpath expr="//group[./group[@name='group_connection']]" position="attributes">
                <attribute name="invisible">platform_type == 'woocommerce'</attribute>
            </xpath>
            <xpath expr="//group[./group[@name='group_connection']]" position="after">
                <group name="group_woo_overview"
                       string="Store"
                       invisible="platform_type != 'woocommerce'">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="warehouse_id"
                             required="platform_type == 'woocommerce' and (woo_auto_import_orders or woo_auto_export_stock)"/>
                    <field name="woo_timezone"/>
                    <field name="lang_id"/>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Credentials"
                      name="woo_credentials"
                      invisible="platform_type != 'woocommerce'"
                      groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <group>
                        <group string="Connection">
                            <field name="name"/>
                            <field name="platform_type" readonly="1"/>
                            <field name="base_url" placeholder="https://your-store.example"
                                     required="platform_type == 'woocommerce'"/>
                            <field name="active"/>
                        </group>
                        <group string="WooCommerce API">
                            <field name="woo_consumer_key" widget="password"
                                     required="platform_type == 'woocommerce'"/>
                            <field name="woo_consumer_secret" widget="password"
                                     required="platform_type == 'woocommerce'"/>
                        </group>
                    </group>
                    <group string="Extra Configuration">
                        <group>
                            <field name="woo_wp_username_display" readonly="1"/>
                            <field name="woo_wp_password_display" widget="password" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_woo_open_wp_media_credentials"
                                    type="object"
                                    string="Set WordPress Media Credentials"
                                    class="btn-secondary"
                                    groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                        </group>
                    </group>
                </page>
                <page string="WooCommerce Settings"
                      name="woo_settings"
                      invisible="platform_type != 'woocommerce'">
                    <group>
                        <group string="Catalog &amp; Pricing">
                            <field name="pricelist_id"/>
                            <field name="woo_regular_pricelist_id"/>
                            <field name="woo_sale_pricelist_id"/>
                            <field name="sales_team_id"/>
                            <field name="woo_import_images"/>
                            <field name="woo_sync_price"/>
                            <field name="woo_sync_weight"/>
                            <field name="woo_weight_unit"/>
                            <field name="woo_default_product_categ_id"/>
                            <field name="woo_create_products"/>
                            <field name="woo_match_by_sku"/>
                        </group>
                        <group string="Orders &amp; Automation">
                            <field name="woo_allow_unmapped_order_lines"/>
                            <field name="woo_order_statuses"/>
                            <field name="kits_auto_confirm_order"/>
                            <field name="woo_auto_import_orders"/>
                            <field name="woo_auto_import_products"/>
                            <field name="woo_auto_export_products"/>
                            <field name="woo_auto_export_stock"/>
                        </group>
                    </group>
                    <group string="Extra Field Mapping" name="woo_product_field_mapping">
                        <field name="woo_product_field_mapping_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="woo_source"/>
                                <field name="woo_field"/>
                                <field name="odoo_model"/>
                                <field name="odoo_field"/>
                                <field name="active"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="WooCommerce Sync Status"
                      name="woo_status"
                      invisible="platform_type != 'woocommerce'">
                    <group col="2">
                        <group string="Last Sync" name="woo_status_last_sync">
                            <field name="woo_last_product_sync"/>
                            <field name="woo_last_product_import"/>
                            <field name="woo_last_customer_sync"/>
                            <field name="woo_last_order_sync"/>
                            <field name="woo_last_stock_sync"/>
                            <field name="woo_last_catalog_sync"/>
                            <field name="woo_last_coupon_sync"/>
                        </group>
                        <group string="Counts" name="woo_status_counts">
                            <field name="woo_bound_product_count"/>
                            <field name="woo_bound_customer_count"/>
                            <field name="woo_imported_order_count"/>
                        </group>
                    </group>
                    <group string="Order Import Failures" name="woo_status_failures">
                        <field name="woo_order_import_failures"
                                widget="text"
                                nolabel="1"
                                colspan="2"
                                placeholder="No pending failed order IDs"/>
                    </group>
                </page>
                <page string="Webhooks"
                      name="woo_webhooks"
                      invisible="platform_type != 'woocommerce'"
                      groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <div class="alert alert-info" role="status">
                        Enable or pause resource webhooks and set Public Webhook URL
                        in Settings → WooCommerce. Use Rebuild Webhook Delivery URLs
                        there after changing the public URL. This tab is for refresh
                        and per-webhook activate, stop, and delete.
                    </div>
                    <group>
                        <button name="action_woo_refresh_webhooks"
                                type="object"
                                string="Refresh Webhooks"
                                class="btn-secondary"
                                invisible="not active"
                                groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                    </group>
                    <field name="woo_webhook_ids_rel" nolabel="1"
                           readonly="not active"
                           context="{'default_instance_id': id}">
                        <list delete="0">
                            <field name="name"/>
                            <field name="topic"/>
                            <field name="webhook_id"/>
                            <field name="status" widget="badge"
                                    decoration-success="status == 'active'"
                                    decoration-warning="status == 'paused'"
                                    decoration-danger="status == 'disabled'"/>
                            <field name="delivery_url"/>
                            <field name="last_error" optional="hide"/>
                            <button name="action_toggle_status"
                                    type="object"
                                    string="Toggle Status"
                                    icon="refresh"
                                    invisible="not parent.active"/>
                            <button name="action_activate"
                                    type="object"
                                    string="Activate"
                                    invisible="status == 'active' or not parent.active"/>
                            <button name="action_stop"
                                    type="object"
                                    string="Stop"
                                    invisible="status != 'active' or not parent.active"/>
                            <button name="action_delete_webhook"
                                    type="object"
                                    icon="delete"
                                    title="Delete"
                                    confirm="Delete this webhook remotely and locally?"
                                    invisible="not parent.active"/>
                        </list>
                    </field>
                </page>
                <page string="Payment &amp; Shipping Maps"
                      name="woo_maps"
                      invisible="platform_type != 'woocommerce'"
                      groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <group>
                        <button name="action_woo_fetch_payment_gateways"
                                type="object"
                                string="Fetch Payment Gateways"
                                class="btn-secondary"
                                icon="payments"/>
                        <button name="action_woo_fetch_shipping_methods"
                                type="object"
                                string="Fetch Shipping Methods"
                                class="btn-secondary"
                                icon="local_shipping"/>
                    </group>
                    <separator string="Payment Gateways"/>
                    <field name="woo_payment_gateway_map_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="woo_gateway_id"/>
                            <field name="woo_title"/>
                            <field name="woo_enabled"/>
                            <field name="payment_method_id"/>
                            <field name="active"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                    <separator string="Shipping Methods"/>
                    <field name="woo_shipping_method_map_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="woo_method_id"/>
                            <field name="woo_method_title"/>
                            <field name="carrier_id"/>
                            <field name="delivery_product_id"/>
                            <field name="active"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                    <div class="alert alert-warning" role="status">
                        Mappings are applied during order import for carrier and
                        shipping product selection. They never create accounting
                        payments or invent delivery pickings.
                    </div>
                </page>
                <page string="Tax Maps"
                      name="woo_tax_maps"
                      invisible="platform_type != 'woocommerce'"
                      groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <group>
                        <group>
                            <field name="woo_tax_mapping_mode"/>
                            <field name="woo_tax_total_tolerance"/>
                            <field name="woo_auto_post_credit_notes"/>
                        </group>
                        <group>
                            <button name="action_woo_fetch_tax_rates"
                                    type="object"
                                    string="Fetch Tax Rates"
                                    class="btn-secondary"
                                    icon="percent"/>
                        </group>
                    </group>
                    <field name="woo_tax_map_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="woo_rate_id"/>
                            <field name="woo_tax_class"/>
                            <field name="woo_rate"/>
                            <field name="woo_name" optional="show"/>
                            <field name="tax_id"/>
                            <field name="is_zero_rated"/>
                            <field name="match_price_include"/>
                            <field name="active"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="status">
                        Map WooCommerce tax rate ids/classes to existing Odoo sales taxes.
                        Zero/Exempt forces no tax. Missing mappings fail in
                        “Require Mapped Taxes” mode; otherwise the documented fallback applies.
                        Tax total discrepancies are reported on the sales order and never
                        silently rewrite accounting.
                    </div>
                </page>
            </xpath>

            <!-- Hide Extra Configuration on WooCommerce stores (optional technical JSON stays available via Studio if needed) -->
            <xpath expr="//page[@name='config']" position="attributes">
                <attribute name="invisible">platform_type == 'woocommerce'</attribute>
            </xpath>
        </field>
    </record>

    <record id="kits_connector_instance_view_list_woo" model="ir.ui.view">
        <field name="name">kits.woo.instance.list.woocommerce</field>
        <field name="model">kits.woo.instance</field>
        <field name="inherit_id" ref="kits_woo_instance_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='platform_type']" position="after">
                <field name="warehouse_id" optional="hide"/>
                <field name="woo_last_order_sync" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="kits_connector_instance_view_search_woo" model="ir.ui.view">
        <field name="name">kits.woo.instance.search.woocommerce</field>
        <field name="model">kits.woo.instance</field>
        <field name="inherit_id" ref="kits_woo_instance_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_connected']" position="before">
                <filter string="WooCommerce"
                        name="filter_woocommerce"
                        domain="[('platform_type', '=', 'woocommerce')]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="kits_woo_instance_action" model="ir.actions.act_window">
        <field name="name">WooCommerce Stores</field>
        <field name="res_model">kits.woo.instance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="kits_woo_instance_view_search"/>
        <field name="context">{
            'default_platform_type': 'woocommerce',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a WooCommerce store connection
            </p>
            <p>
                Set company, warehouse, timezone, and language on the store.
                Connection keys live on the Credentials page; sync options on WooCommerce Settings.
            </p>
        </field>
    </record>

</odoo>
