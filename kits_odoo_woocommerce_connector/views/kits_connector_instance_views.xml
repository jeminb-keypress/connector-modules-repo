<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kits_connector_instance_view_form_woo" model="ir.ui.view">
        <field name="name">kits.connector.instance.form.woocommerce</field>
        <field name="model">kits.connector.instance</field>
        <field name="inherit_id" ref="kits_odoo_base_connector.kits_connector_instance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_woo_open_sync_wizard"
                        type="object"
                        string="Sync Operation"
                        class="btn-secondary"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_import_products"
                        type="object"
                        string="Import Products"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_export_products"
                        type="object"
                        string="Export Products"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_import_orders"
                        type="object"
                        string="Import Orders"
                        class="btn-primary"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_import_customers"
                        type="object"
                        string="Import Customers"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_export_inventory"
                        type="object"
                        string="Export Inventory"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_import_categories"
                        type="object"
                        string="Import Categories"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_import_attributes"
                        type="object"
                        string="Import Attributes"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_import_coupons"
                        type="object"
                        string="Import Coupons"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_export_coupons"
                        type="object"
                        string="Export Coupons"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_register_customer_webhooks"
                        type="object"
                        string="Register Customer Webhooks"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_unregister_customer_webhooks"
                        type="object"
                        string="Unregister Customer Webhooks"
                        invisible="platform_type != 'woocommerce' or not woo_webhook_enabled"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_register_resource_webhooks"
                        type="object"
                        string="Register Catalog/Order Webhooks"
                        invisible="platform_type != 'woocommerce'"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
                <button name="action_woo_unregister_resource_webhooks"
                        type="object"
                        string="Unregister Catalog/Order Webhooks"
                        invisible="platform_type != 'woocommerce' or not woo_resource_webhooks_enabled"
                        groups="kits_odoo_base_connector.group_kits_connector_manager"/>
            </xpath>
            <!-- Generic base credentials are not used for WooCommerce (consumer key/secret instead) -->
            <xpath expr="//group[@name='group_credentials']" position="attributes">
                <attribute name="invisible">platform_type == 'woocommerce'</attribute>
            </xpath>
            <xpath expr="//group[@name='group_credentials']" position="after">
                <group name="group_woo_credentials"
                       string="WooCommerce Credentials"
                       invisible="platform_type != 'woocommerce'"
                       groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <field name="woo_consumer_key" widget="password"/>
                    <field name="woo_consumer_secret" widget="password"/>
                    <field name="woo_api_version"/>
                </group>
                <group name="group_woo_settings"
                       string="WooCommerce Store Settings"
                       invisible="platform_type != 'woocommerce'">
                    <field name="warehouse_id"
                             required="platform_type == 'woocommerce' and (woo_auto_import_orders or woo_auto_export_stock)"/>
                    <field name="pricelist_id"/>
                    <field name="sales_team_id"/>
                    <field name="woo_import_images"/>
                    <field name="woo_match_by_sku"/>
                    <field name="woo_allow_unmapped_order_lines"/>
                    <field name="woo_order_statuses"/>
                    <field name="woo_auto_import_orders"/>
                    <field name="woo_auto_import_customers"/>
                    <field name="woo_auto_export_products"/>
                    <field name="woo_auto_export_stock"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="WooCommerce Sync Status"
                      name="woo_status"
                      invisible="platform_type != 'woocommerce'">
                    <group>
                        <group>
                            <field name="woo_last_product_sync"/>
                            <field name="woo_last_customer_sync"/>
                            <field name="woo_last_order_sync"/>
                            <field name="woo_last_stock_sync"/>
                            <field name="woo_last_catalog_sync"/>
                            <field name="woo_last_coupon_sync"/>
                        </group>
                        <group>
                            <field name="woo_bound_product_count"/>
                            <field name="woo_bound_customer_count"/>
                            <field name="woo_imported_order_count"/>
                            <field name="woo_order_import_failures" widget="text"/>
                        </group>
                    </group>
                </page>
                <page string="Webhooks"
                      name="woo_webhooks"
                      invisible="platform_type != 'woocommerce'"
                      groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <group>
                        <group string="Delivery">
                            <field name="woo_webhook_public_base_url"
                                    placeholder="https://odoo.example.com"/>
                            <field name="woo_webhook_resource_base_url" readonly="1"/>
                            <field name="woo_webhook_endpoint_url" readonly="1"/>
                            <field name="woo_webhook_enabled" readonly="1"/>
                            <field name="woo_resource_webhooks_enabled" readonly="1"/>
                            <field name="woo_webhook_secret" widget="password"/>
                        </group>
                        <group string="Registered Topics">
                            <field name="woo_webhook_ids" readonly="1" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        WooCommerce must reach a public HTTPS Odoo URL (or a tunnel /
                        local URL in development). Supported resources: customers,
                        products, orders, coupons. HMAC-SHA256 verification applies
                        to all. Remote deletes mark bindings Deleted Remote and never
                        auto-delete Odoo records. Product webhooks ignore Woo stock
                        quantities (Odoo remains inventory source of truth).
                        Multi-DB: prefer dbfilter/single DB. If using X-Odoo-Database,
                        set system parameter kits_woo.webhook_db_allowlist to an
                        explicit comma-separated allowlist (arbitrary DB names are rejected).
                    </div>
                </page>
                <page string="Payment &amp; Shipping Maps"
                      name="woo_maps"
                      invisible="platform_type != 'woocommerce'"
                      groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <group>
                        <button name="action_woo_fetch_payment_gateways"
                                type="object"
                                string="Fetch Payment Gateways"
                                class="btn-secondary"
                                icon="payments"/>
                        <button name="action_woo_fetch_shipping_methods"
                                type="object"
                                string="Fetch Shipping Methods"
                                class="btn-secondary"
                                icon="local_shipping"/>
                    </group>
                    <separator string="Payment Gateways"/>
                    <field name="woo_payment_gateway_map_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="woo_gateway_id"/>
                            <field name="woo_title"/>
                            <field name="woo_enabled"/>
                            <field name="payment_method_id"/>
                            <field name="active"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                    <separator string="Shipping Methods"/>
                    <field name="woo_shipping_method_map_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="woo_method_id"/>
                            <field name="woo_method_title"/>
                            <field name="carrier_id"/>
                            <field name="delivery_product_id"/>
                            <field name="active"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                    <div class="alert alert-warning" role="status">
                        Mappings are applied during order import for carrier and
                        shipping product selection. They never create accounting
                        payments or invent delivery pickings.
                    </div>
                </page>
                <page string="Tax Maps"
                      name="woo_tax_maps"
                      invisible="platform_type != 'woocommerce'"
                      groups="kits_odoo_base_connector.group_kits_connector_manager">
                    <group>
                        <group>
                            <field name="woo_tax_mapping_mode"/>
                            <field name="woo_tax_total_tolerance"/>
                            <field name="woo_auto_post_credit_notes"/>
                        </group>
                        <group>
                            <button name="action_woo_fetch_tax_rates"
                                    type="object"
                                    string="Fetch Tax Rates"
                                    class="btn-secondary"
                                    icon="percent"/>
                        </group>
                    </group>
                    <field name="woo_tax_map_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="woo_rate_id"/>
                            <field name="woo_tax_class"/>
                            <field name="woo_rate"/>
                            <field name="woo_name" optional="show"/>
                            <field name="tax_id"/>
                            <field name="is_zero_rated"/>
                            <field name="match_price_include"/>
                            <field name="active"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="status">
                        Map WooCommerce tax rate ids/classes to existing Odoo sales taxes.
                        Zero/Exempt forces no tax. Missing mappings fail in
                        “Require Mapped Taxes” mode; otherwise the documented fallback applies.
                        Tax total discrepancies are reported on the sales order and never
                        silently rewrite accounting.
                    </div>
                </page>
            </xpath>
            <xpath expr="//field[@name='base_url']" position="attributes">
                <attribute name="placeholder">https://your-store.example</attribute>
            </xpath>
        </field>
    </record>

    <record id="kits_connector_instance_view_list_woo" model="ir.ui.view">
        <field name="name">kits.connector.instance.list.woocommerce</field>
        <field name="model">kits.connector.instance</field>
        <field name="inherit_id" ref="kits_odoo_base_connector.kits_connector_instance_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='platform_type']" position="after">
                <field name="warehouse_id" optional="hide"/>
                <field name="woo_last_order_sync" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="kits_connector_instance_view_search_woo" model="ir.ui.view">
        <field name="name">kits.connector.instance.search.woocommerce</field>
        <field name="model">kits.connector.instance</field>
        <field name="inherit_id" ref="kits_odoo_base_connector.kits_connector_instance_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_connected']" position="before">
                <filter string="WooCommerce"
                        name="filter_woocommerce"
                        domain="[('platform_type', '=', 'woocommerce')]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="kits_woo_instance_action" model="ir.actions.act_window">
        <field name="name">WooCommerce Stores</field>
        <field name="res_model">kits.connector.instance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('platform_type', '=', 'woocommerce')]</field>
        <field name="context">{
            'default_platform_type': 'woocommerce',
            'search_default_filter_woocommerce': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a WooCommerce store connection
            </p>
            <p>
                Configure the store URL, REST API consumer key/secret, warehouse, and pricelist.
                Then use Import/Export actions or enable scheduled sync.
            </p>
        </field>
    </record>
</odoo>
